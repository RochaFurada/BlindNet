%%{init: {"theme": "base", "flowchart": {"curve": "linear", "nodeSpacing": 55, "rankSpacing": 70, "htmlLabels": true}}}%%
flowchart TB
    %% BlindNet - fluxograma de atividade completo
    %% Organizado por modulos, com fluxo principal de cima para baixo.

    classDef start fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#111;
    classDef activity fill:#FFFDE7,stroke:#F9A825,stroke-width:1.5px,color:#111;
    classDef decision fill:#F3E5F5,stroke:#6A1B9A,stroke-width:1.5px,color:#111;
    classDef security fill:#E3F2FD,stroke:#1565C0,stroke-width:1.5px,color:#111;
    classDef reject fill:#FFEBEE,stroke:#C62828,stroke-width:1.5px,color:#111;
    classDef data fill:#ECEFF1,stroke:#455A64,stroke-width:1.5px,color:#111;
    classDef endNode fill:#FAFAFA,stroke:#111,stroke-width:3px,color:#111;

    Start((Inicio)):::start
    End((Fim)):::endNode

    subgraph Boot["Modulo 1 - Inicializacao e configuracao"]
        direction TB
        A01["Ligar Guardian ESP32"]:::activity
        A02["Preparar ambiente interno"]:::activity
        A03["Inicializar event_bus"]:::activity
        A04["Inicializar config_store"]:::activity
        D01{"Existir configuracao salva?"}:::decision

        A05["Ativar AP temporario de setup"]:::activity
        A06["Iniciar servidor administrativo"]:::activity
        A07["Informar rede, zona, chaves e politicas"]:::activity
        A08["Salvar configuracao persistente na NVS"]:::data
        A09["Reiniciar Guardian"]:::activity

        A10["Carregar configuracao valida"]:::activity
    end

    subgraph Normal["Modulo 2 - Subir operacao normal"]
        direction TB
        B01["Inicializar registro de dispositivos"]:::activity
        B02["Ativar Wi-Fi AP/STA da zona"]:::activity
        B03["Inicializar tabela de fluxos"]:::activity
        B04["Carregar politicas locais"]:::activity
        B05["Configurar limitador de taxa"]:::activity
        B06["Inicializar quarentena"]:::activity
        B07["Ativar firewall da zona"]:::security
        B08["Ativar gateway e NAPT"]:::activity
        B09["Ativar filtro DNS"]:::security
        B10["Ativar broker MQTT local"]:::activity
        B11["Ativar transporte G2G por BLE"]:::activity
        B12["Ativar telemetria periodica"]:::activity
        B13["Manter Guardian pronto para operar"]:::activity
    end

    subgraph Build["Modulo 3 - Criar e transportar Action Pill"]
        direction TB
        C01["Criar comando seguro no app ou automacao"]:::activity
        C02["Montar Capsule Pill com TTL, nonce, rede e emissor"]:::security
        C03["Cifrar Active Substance com segredo do alvo"]:::security
        C04["Calcular hash do conteudo cifrado"]:::security
        C05["Assinar capsula imutavel"]:::security
        C06["Anexar capsula e conteudo cifrado ao pacote"]:::activity
        C07["Fragmentar pacote para BLE G2G"]:::activity
        C08["Enviar fragmentos ao Guardian"]:::activity
    end

    subgraph Receive["Modulo 4 - Receber pacote e montar acao"]
        direction TB
        D02["Receber fragmento BLE"]:::activity
        D03["Validar versao, tipo e tamanho"]:::security
        D04["Agrupar fragmentos por message_id"]:::activity
        D05{"Completar todos os fragmentos?"}:::decision
        D06["Aguardar proximos fragmentos"]:::activity
        D07["Recompor Action Pill"]:::activity
        D08["Conferir digest do message_id"]:::security
        D09{"Identificar pacote repetido?"}:::decision
        D10["Descartar repeticao ou loop"]:::reject
    end

    subgraph Stomach["Modulo 5 - Validar Stomach e anti-replay"]
        direction TB
        E01["Calcular digest da Capsule Pill"]:::security
        E02["Registrar digest no cache anti-replay"]:::data
        E03{"Capsula ja vista?"}:::decision
        E04["Descartar comando duplicado"]:::reject
        E05["Validar envelope da Active Substance"]:::security
        E06["Validar validade basica da Capsule Pill"]:::security
        E07["Validar rede esperada"]:::security
        E08["Validar emissor autorizado"]:::security
        E09["Comparar hash da capsula com Active Substance"]:::security
        E10["Verificar assinatura da capsula"]:::security
        E11{"Autorizar capsula?"}:::decision
        E12["Rejeitar por integridade ou autorizacao invalida"]:::reject
    end

    subgraph Relay["Modulo 6 - Decidir execucao local ou repasse"]
        direction TB
        F01["Tentar abrir conteudo cifrado com segredos locais"]:::security
        F02{"Conseguir abrir localmente?"}:::decision
        F03{"Precisar encaminhar para outros Guardians?"}:::decision
        F04["Encaminhar pacote sem alterar CP nem AS"]:::activity
        F05["Nao executar localmente"]:::activity
        F06["Extrair comando e dispositivo alvo"]:::activity
    end

    subgraph Membrane["Modulo 7 - Autorizar comando e acionar dispositivo"]
        direction TB
        G01["Consultar dispositivo na Ribosome Table"]:::data
        G02["Validar formato do comando"]:::security
        G03["Consultar template na RNA Membrane"]:::data
        G04["Validar amino e payload permitidos"]:::security
        G05{"Permitir comando?"}:::decision
        G06["Bloquear execucao"]:::reject
        G07["Codificar payload MQTT"]:::activity
        G08["Publicar comando no broker MQTT"]:::activity
        G09["Executar acao no dispositivo IoT"]:::activity
    end

    subgraph Traffic["Modulo 8 - Proteger trafego da zona"]
        direction TB
        H01["Receber consulta DNS ou fluxo TCP/UDP/ICMP"]:::activity
        H02["Atualizar flow_table"]:::data
        H03["Verificar quarentena da origem"]:::security
        H04{"Origem estar bloqueada?"}:::decision
        H05["Derrubar fluxo"]:::reject
        H06["Avaliar politica local"]:::security
        H07{"Politica determinar acao?"}:::decision
        H08["Aplicar limite de taxa"]:::security
        H09{"Exceder limite?"}:::decision
        H10["Quarentenar origem suspeita"]:::reject
        H11["Permitir, redirecionar ou registrar fluxo"]:::activity
        H12["Encaminhar trafego ao gateway ou DNS upstream"]:::activity
    end

    subgraph Observe["Modulo 9 - Registrar eventos e telemetria"]
        direction TB
        I01["Publicar evento interno"]:::data
        I02["Atualizar estado de dispositivo"]:::data
        I03["Compartilhar aviso no swarm quando necessario"]:::activity
        I04["Coletar snapshot de rede, politicas e quarentena"]:::activity
        I05["Enviar telemetria ao console ou coletor"]:::activity
        I06["Continuar operacao do Guardian"]:::activity
        I07["Finalizar somente em desligamento ou reinicio"]:::activity
    end

