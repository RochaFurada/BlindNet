flowchart TD
    %% BlindNet - visao geral do sistema completo

    User["Usuario"]
    App["App do usuario<br/>gera comando, cifra AS e assina CP"]
    ObjectSecret["Segredo/hash do objeto<br/>dispositivo alvo sem revelar destino"]

    subgraph ActionPill["Action Pill"]
        AP["AP externo<br/>camada mutavel de transporte"]
        CP["CP<br/>capsula imutavel assinada<br/>TTL, nonce, network_id, active_hash"]
        AS["AS<br/>active_substance cifrado<br/>opaco para Guardians intermediarios"]
    end

    subgraph GuardianA["Guardian A - ESP32"]
        BLEA["BLE transport<br/>plano de controle BlindNet"]
        StomachA["Stomach<br/>digestao do AP"]
        CacheA["Cache cp_digest<br/>ultimos CPs vistos"]
        RelayA["Relay imediato<br/>duplica AP e encaminha"]
        ValidateA["Validacao tardia<br/>assinatura CP + hash AS"]
        TryOpenA["Tentativa local<br/>abrir AS com chaves dos dispositivos"]

        WiFiA["Wi-Fi AP/STA"]
        GatewayA["zone_gateway<br/>NAPT / uplink"]
        FirewallA["zone_firewall"]
        DNSA["dns_filter"]
        PolicyA["policy_engine"]
        RateA["rate_limiter"]
        QuarantineA["quarantine_manager"]
        RegistryA["device_registry"]
        FlowA["flow_table"]
        MQTTA["MQTT broker / controle local"]
        DevicesA["Dispositivos IoT<br/>zona local A"]
        TelemetryA["telemetry_agent"]
        EventsA["event_bus"]
        ConfigA["config_store<br/>NVS"]
        AdminA["admin_server<br/>somente setup"]
    end

    subgraph GuardianB["Guardian B - ESP32"]
        BLEB["BLE transport<br/>plano de controle BlindNet"]
        StomachB["Stomach<br/>digestao do AP"]
        CacheB["Cache cp_digest<br/>ultimos CPs vistos"]
        RelayB["Relay imediato<br/>duplica AP e encaminha"]
        ValidateB["Validacao tardia<br/>assinatura CP + hash AS"]
        TryOpenB["Tentativa local<br/>abrir AS com chaves dos dispositivos"]

        WiFiB["Wi-Fi AP/STA"]
        GatewayB["zone_gateway<br/>NAPT / uplink"]
        FirewallB["zone_firewall"]
        DNSB["dns_filter"]
        PolicyB["policy_engine"]
        RateB["rate_limiter"]
        QuarantineB["quarantine_manager"]
        RegistryB["device_registry"]
        FlowB["flow_table"]
        MQTTB["MQTT broker / controle local"]
        DevicesB["Dispositivos IoT<br/>zona local B"]
        TelemetryB["telemetry_agent"]
        EventsB["event_bus"]
        ConfigB["config_store<br/>NVS"]
        AdminB["admin_server<br/>somente setup"]
    end

    Monitor["Console serial<br/>ou coletor UDP"]
    Internet["Roteador / Internet<br/>uplink opcional"]
    SetupUser["Administrador<br/>setup inicial"]

    User --> App
    ObjectSecret --> App
    App -->|"cria camada externa"| AP
    App -->|"gera nucleo imutavel"| CP
    App -->|"anexa blob cifrado"| AS
    AP -->|"carrega"| CP
    AP -->|"carrega"| AS

    AP -->|"BLE direto<br/>sem roteador e sem senha do AP local"| BLEA
    BLEA --> StomachA
    StomachA -->|"calcula SHA-256 do CP"| CacheA
    CacheA -->|"ja visto"| DropA["Descarta<br/>anti-loop / anti-replay"]
    CacheA -->|"novo"| RelayA
    RelayA -->|"reembala so AP<br/>CP e AS intactos"| BLEB
    CacheA -->|"novo, em paralelo"| ValidateA --> TryOpenA
    TryOpenA -->|"nao abriu"| NoLocalA["Nao executa localmente"]
    TryOpenA -->|"abriu"| PolicyA

    BLEB --> StomachB
    StomachB -->|"calcula SHA-256 do CP"| CacheB
    CacheB -->|"ja visto"| DropB["Descarta<br/>anti-loop / anti-replay"]
    CacheB -->|"novo"| RelayB
    RelayB -->|"reembala so AP<br/>CP e AS intactos"| BLEA
    CacheB -->|"novo, em paralelo"| ValidateB --> TryOpenB
    TryOpenB -->|"nao abriu"| NoLocalB["Nao executa localmente"]
    TryOpenB -->|"abriu"| PolicyB

    PolicyA -->|"permitido"| MQTTA --> DevicesA
    PolicyA -->|"negado / risco"| QuarantineA
    PolicyB -->|"permitido"| MQTTB --> DevicesB
    PolicyB -->|"negado / risco"| QuarantineB

    DevicesA --> WiFiA
    WiFiA --> DNSA
    WiFiA --> FirewallA
    FirewallA --> FlowA
    FirewallA --> PolicyA
    FirewallA --> RateA
    FirewallA --> QuarantineA
    FirewallA --> RegistryA
    WiFiA --> GatewayA --> Internet

    DevicesB --> WiFiB
    WiFiB --> DNSB
    WiFiB --> FirewallB
    FirewallB --> FlowB
    FirewallB --> PolicyB
    FirewallB --> RateB
    FirewallB --> QuarantineB
    FirewallB --> RegistryB
    WiFiB --> GatewayB --> Internet

    DNSA --> EventsA
    FirewallA --> EventsA
    RegistryA --> EventsA
    ConfigA --> EventsA
    TelemetryA --> Monitor
    TelemetryA --> WiFiA
    TelemetryA --> GatewayA
    TelemetryA --> FlowA
    TelemetryA --> PolicyA
    TelemetryA --> RateA
    TelemetryA --> QuarantineA

    DNSB --> EventsB
    FirewallB --> EventsB
    RegistryB --> EventsB
    ConfigB --> EventsB
    TelemetryB --> Monitor
    TelemetryB --> WiFiB
    TelemetryB --> GatewayB
    TelemetryB --> FlowB
    TelemetryB --> PolicyB
    TelemetryB --> RateB
    TelemetryB --> QuarantineB

    SetupUser -->|"sem config salva"| AdminA --> ConfigA
    SetupUser -->|"sem config salva"| AdminB --> ConfigB

    CP -. "alterar CP quebra assinatura" .-> ValidateA
    CP -. "alterar CP quebra assinatura" .-> ValidateB
    AS -. "trocar AS quebra active_hash no CP" .-> ValidateA
    AS -. "trocar AS quebra active_hash no CP" .-> ValidateB
    AP -. "AP pode mudar a cada salto" .-> RelayA
    AP -. "AP pode mudar a cada salto" .-> RelayB

    BLEA -. "plano BlindNet isolado<br/>nao acessa admin_server<br/>nao acessa IoT diretamente" .-> WiFiA
    BLEB -. "plano BlindNet isolado<br/>nao acessa admin_server<br/>nao acessa IoT diretamente" .-> WiFiB
