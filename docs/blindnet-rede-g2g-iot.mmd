%%{init: {"theme": "base", "flowchart": {"curve": "linear", "nodeSpacing": 60, "rankSpacing": 75, "htmlLabels": true}}}%%
flowchart LR
    %% BlindNet - diagrama de rede G2G, dono, Guardians e dispositivos IoT
    %% Organizacao visual: esquerda para direita, sem curvas e com conexoes nomeadas.

    classDef actor fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#111;
    classDef packet fill:#FFFDE7,stroke:#F9A825,stroke-width:1.5px,color:#111;
    classDef g2g fill:#E3F2FD,stroke:#1565C0,stroke-width:1.5px,color:#111;
    classDef security fill:#F3E5F5,stroke:#6A1B9A,stroke-width:1.5px,color:#111;
    classDef broker fill:#ECEFF1,stroke:#455A64,stroke-width:1.5px,color:#111;
    classDef iot fill:#E0F2F1,stroke:#00695C,stroke-width:1.5px,color:#111;
    classDef external fill:#FAFAFA,stroke:#616161,stroke-width:1.5px,color:#111;

    subgraph Owner["Dispositivo do dono"]
        direction TB
        U01["Usuario dono"]:::actor
        U02["App BlindNet"]:::actor
        U03["Escolher dispositivo alvo"]:::actor
        U04["Criar comando seguro"]:::actor
    end

    subgraph Pill["Action Pill"]
        direction TB
        P01["AP<br/>camada externa mutavel"]:::packet
        P02["CP<br/>capsula assinada<br/>TTL, nonce, network_id e active_hash"]:::packet
        P03["AS<br/>conteudo cifrado<br/>opaco para Guardians intermediarios"]:::packet
    end

    subgraph G2GNet["Rede G2G BlindNet"]
        direction TB
        G01["BLE G2G<br/>fragmentar e transmitir"]:::g2g
        G02["Malha de Guardians<br/>encaminhar pacote por proximidade"]:::g2g
        G03["Anti-replay por message_id<br/>evitar loop"]:::security
    end

    subgraph GuardianA["Guardian A - Zona local"]
        direction TB
        A01["Receptor BLE G2G"]:::g2g
        A02["Stomach<br/>validar CP, AS e assinatura"]:::security
        A03["Tentar abrir AS<br/>com segredos locais"]:::security
        A04{"Abrir conteudo localmente?"}:::security
        A05["Encaminhar para rede G2G"]:::g2g
        A06["Membrane<br/>validar dispositivo, amino e payload"]:::security
        A07["Broker MQTT local"]:::broker
        A08["Firewall, DNS, rate limit e quarentena"]:::security
    end

    subgraph IoTA["Dispositivos IoT - Zona A"]
        direction TB
        IA1["Lampada inteligente"]:::iot
        IA2["Sensor de presenca"]:::iot
        IA3["Tomada inteligente"]:::iot
    end

    subgraph GuardianB["Guardian B - Zona vizinha"]
        direction TB
        B01["Receptor BLE G2G"]:::g2g
        B02["Stomach<br/>validar CP, AS e assinatura"]:::security
        B03["Tentar abrir AS<br/>com segredos locais"]:::security
        B04{"Abrir conteudo localmente?"}:::security
        B05["Encaminhar para rede G2G"]:::g2g
        B06["Membrane<br/>validar dispositivo, amino e payload"]:::security
        B07["Broker MQTT local"]:::broker
        B08["Firewall, DNS, rate limit e quarentena"]:::security
    end

    subgraph IoTB["Dispositivos IoT - Zona B"]
        direction TB
        IB1["Fechadura inteligente"]:::iot
        IB2["Camera IP"]:::iot
        IB3["Ar condicionado"]:::iot
    end

    subgraph Observability["Observabilidade e apoio"]
        direction TB
        O01["Event bus"]:::external
        O02["Telemetry agent"]:::external
        O03["Console serial ou coletor UDP"]:::external
        O04["Config store NVS"]:::external
        O05["Admin server<br/>somente setup"]:::external
    end

