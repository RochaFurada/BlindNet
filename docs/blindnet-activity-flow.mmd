flowchart TD
    %% BlindNet / Cortex - diagrama de atividade geral
    %% Sem nomes de funcoes: mostra o que cada etapa faz no fluxo do sistema.

    classDef start fill:#e8f5e9,stroke:#2e7d32,color:#111;
    classDef activity fill:#fffde7,stroke:#f9a825,color:#111;
    classDef decision fill:#f3e5f5,stroke:#6a1b9a,color:#111;
    classDef security fill:#e3f2fd,stroke:#1565c0,color:#111;
    classDef stop fill:#ffebee,stroke:#c62828,color:#111;
    classDef todo fill:#fbe9e7,stroke:#d84315,color:#111;

    Start(["Guardian liga"]) --> Prepare["Prepara ambiente interno"]
    Prepare --> LoadConfig{"Existe configuracao salva?"}

    LoadConfig -- "nao" --> SetupMode["Entra em modo de configuracao"]
    SetupMode --> AdminConfig["Administrador informa rede, zona e chaves"]
    AdminConfig --> SaveConfig["Salva configuracao persistente"]
    SaveConfig --> Restart["Reinicia dispositivo"]
    Restart --> Start

    LoadConfig -- "sim" --> NormalMode["Entra em modo normal"]
    NormalMode --> StartNetwork["Ativa rede local e uplink quando existir"]
    StartNetwork --> StartProtection["Ativa protecoes da zona"]
    StartProtection --> StartTelemetry["Ativa eventos e telemetria"]
    StartTelemetry --> Ready["Guardian pronto para operar"]

    User(["Usuario ou automacao"]) --> BuildCommand["Cria comando seguro"]
    BuildCommand --> BuildCapsule["Monta capsula assinada com metadados e hash"]
    BuildCommand --> BuildActive["Monta conteudo cifrado da acao"]
    BuildCapsule --> SendPill["Envia pacote pelo transporte escolhido"]
    BuildActive --> SendPill

    Ready --> Receive{"Chegou pacote de comando?"}
    Receive -- "nao" --> Maintain["Mantem servicos, rede, eventos e telemetria"]
    Maintain --> Receive

    Receive -- "sim" --> Decode["Separa capsula e conteudo cifrado"]
    Decode --> JoinPill["Une capsula e conteudo em uma acao logica"]
    JoinPill --> CheckBinding{"Capsula corresponde ao conteudo cifrado?"}

    CheckBinding -- "nao" --> RejectTamper["Rejeita por integridade invalida"]
    CheckBinding -- "sim" --> CheckSeen{"Comando ja passou por este Guardian?"}

    CheckSeen -- "sim" --> DropReplay["Descarta para evitar repeticao ou loop"]
    CheckSeen -- "nao" --> MarkSeen["Registra comando como visto"]

    MarkSeen --> ValidateCapsule["Valida validade, rede, emissor e assinatura"]
    ValidateCapsule --> CapsuleOk{"Capsula autorizada?"}

    CapsuleOk -- "nao" --> RejectUnauthorized["Rejeita por autorizacao invalida"]
    CapsuleOk -- "sim" --> TryOpen["Tenta abrir o conteudo cifrado com segredos locais"]

    TryOpen --> Opened{"Este Guardian consegue abrir?"}
    Opened -- "nao" --> RelayDecision{"Deve encaminhar para outros Guardians?"}
    RelayDecision -- "sim" --> Relay["Encaminha pacote sem alterar capsula nem conteudo"]
    RelayDecision -- "nao" --> StopLocal["Nao executa localmente"]

    Opened -- "sim" --> IdentifyTarget["Identifica dispositivo e acao solicitada"]
    IdentifyTarget --> CheckPolicy["Consulta regras locais da zona"]
    CheckPolicy --> PolicyOk{"Acao permitida?"}

    PolicyOk -- "nao" --> DenyAction["Bloqueia ou coloca origem em quarentena"]
    PolicyOk -- "sim" --> ExecuteAction["Executa a acao no dispositivo alvo"]
    ExecuteAction --> ReportSuccess["Registra evento e telemetria"]
    DenyAction --> ReportDenied["Registra bloqueio e risco"]

    Relay --> ReportRelay["Registra encaminhamento"]
    RejectTamper --> ReportReject["Registra rejeicao"]
    RejectUnauthorized --> ReportReject
    DropReplay --> ReportReject
    StopLocal --> ReportReject

    ReportSuccess --> Receive
    ReportDenied --> Receive
    ReportRelay --> Receive
    ReportReject --> Receive

    subgraph Responsibilities["Responsabilidades por camada"]
        RustLogic["Rust<br/>decide fluxo, validacao logica e orquestracao"]
        CPlatform["C<br/>executa hardware, rede, memoria sensivel e criptografia de baixo nivel"]
        ConscienceTodo["Conscience<br/>futuro fluxo simbolico de estados"]
    end

    JoinPill -.-> RustLogic
    ValidateCapsule -.-> RustLogic
    CheckPolicy -.-> RustLogic
    StartNetwork -.-> CPlatform
    StartProtection -.-> CPlatform
    TryOpen -.-> CPlatform
    ExecuteAction -.-> CPlatform
    BuildCommand -.-> ConscienceTodo

    class Start,User start;
    class Prepare,SetupMode,AdminConfig,SaveConfig,Restart,NormalMode,StartNetwork,StartProtection,StartTelemetry,Ready,BuildCommand,BuildCapsule,BuildActive,SendPill,Maintain,Decode,JoinPill,MarkSeen,ValidateCapsule,TryOpen,Relay,IdentifyTarget,CheckPolicy,ExecuteAction,ReportSuccess,ReportDenied,ReportRelay,ReportReject activity;
    class LoadConfig,Receive,CheckBinding,CheckSeen,CapsuleOk,Opened,RelayDecision,PolicyOk decision;
    class RejectTamper,DropReplay,RejectUnauthorized,DenyAction,StopLocal stop;
    class RustLogic,CPlatform security;
    class ConscienceTodo todo;
